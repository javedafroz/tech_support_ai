# API
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
DATABASE_URL=postgresql+asyncpg://techsupport:techsupport@localhost:5433/techsupport
DATABASE_URL_SYNC=postgresql://techsupport:techsupport@localhost:5433/techsupport
REDIS_URL=redis://localhost:6380/0
REDIS_SESSION_TTL_SECONDS=86400

# Auth: dev = X-User-Id header; jwt = Bearer only
AUTH_MODE=dev
AUTH_DEV_HEADER_USER_ID=X-User-Id
# AUTH_JWT_SECRET=change-me-for-jwt-tests
# AUTH_JWT_AUDIENCE=

# Object store (MinIO local)
S3_ENDPOINT=http://localhost:9002
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=attachments
S3_REGION=us-east-1

# LangGraph (Sprint 5+)
GRAPH_ENABLED=true
GRAPH_LLM_MODE=openai
# LLM provider when GRAPH_LLM_MODE is not mock: openai | azure_openai | anthropic
LLM_PROVIDER=openai
# GRAPH_CHECKPOINT=true

# Thought streaming — live processing labels over SSE (UI reads this via /api/v1/config/public)
THOUGHT_STREAMING_ENABLED=false
# Optional UI-only override to force-disable streaming: VITE_THOUGHT_STREAMING_ENABLED=false
# Ticketing provider: zammad (live) | servicenow (stub adapter)
TICKETING_PROVIDER=zammad

# OpenAI (default LLM provider)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=   # optional; leave unset for api.openai.com

# Azure OpenAI (when LLM_PROVIDER=azure_openai)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Anthropic Claude (when LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional shared LLM temperature (default 0.2)
# LLM_TEMPERATURE=0.2

# Live integration — AI User Simulator (optional; defaults to OPENAI_MODEL)
# USER_SIM_MODEL=gpt-4o-mini
# USER_SIM_TEMPERATURE=0.4
# INTEGRATION_MAX_TURNS=12
# Browser live tests only (make test-live-ui). Ignored by API-only make test-live.
# INTEGRATION_HEADLESS=false
# INTEGRATION_SLOW_MO=350             # ms pause between UI actions (browser mode)
# INTEGRATION_UI_PAUSE_MS=2500        # pause after ticket created (browser mode)
# LIVE_API_PORT=8020                  # ports for make test-live-ui
# LIVE_WEB_PORT=5175

# Web → API (local `make web`: leave unset, Vite proxies to localhost:8000)
# Docker Compose sets VITE_API_BASE_URL=http://localhost:8000 automatically
# VITE_API_BASE_URL=http://localhost:8000
# API_PROXY_TARGET=http://localhost:8000

# Zammad (sandbox — never commit real tokens)
# Local Zammad on host: use http://localhost:8080 for `make api` on the host.
# Docker Compose API rewrites localhost → host.docker.internal automatically.
ZAMMAD_BASE_URL=https://your-zammad.example.com
ZAMMAD_API_TOKEN=
ZAMMAD_TEST_EMAIL=your.name@company.com

# ---------------------------------------------------------------------------
# KB / RAG (Phase 0+)
# ---------------------------------------------------------------------------
KB_RAG_ENABLED=false
VECTOR_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=agent_handbook
EMBEDDING_PROVIDER=openai
# For local tests without OpenAI: EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
KB_RETRIEVAL_TOP_K=5
KB_MIN_SCORE=0.35
KB_MAX_TROUBLESHOOT_STEPS=5
# Max characters of retrieved handbook text passed into the RAG prompt (bodies only)
KB_RAG_MAX_CONTEXT_CHARS=12000
KB_INCLUDE_CHAT_TRANSCRIPT_IN_TICKET=true
PDF_TO_MARKDOWN_CONVERTER=docling
# Enable only for scanned PDFs; RapidOCR roughly doubles peak memory and can OOM Docker
KB_PDF_OCR_ENABLED=false
# Chunking: default one chunk per PDF page (falls back to headings for markdown without pages)
KB_CHUNK_STRATEGY=page
KB_CHUNK_MAX_CHARS=4000
KB_CHUNK_OVERLAP_CHARS=200

# Handbook object storage (S3-compatible). Production: Ceph RGW. Local Compose: MinIO via CEPH_RGW_*.
# Attachment MinIO (S3_*) is separate — do not reuse attachment bucket credentials for handbooks in production.
KB_HANDBOOK_S3_BUCKET=agent-handbooks
KB_HANDBOOK_STORAGE_BACKEND=memory
# Local MinIO example (host-run API; Compose API sets these automatically):
# KB_HANDBOOK_STORAGE_BACKEND=s3
# CEPH_RGW_ENDPOINT=http://localhost:9002
# CEPH_RGW_ACCESS_KEY=minioadmin
# CEPH_RGW_SECRET_KEY=minioadmin
# CEPH_RGW_REGION=us-east-1
# CEPH_RGW_ADDRESSING_STYLE=path
# Production Ceph RGW:
# CEPH_RGW_ENDPOINT=https://rgw.example.com
# CEPH_RGW_ACCESS_KEY=
# CEPH_RGW_SECRET_KEY=

# Keycloak (admin SPA + admin API)
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=tech-support
KEYCLOAK_ADMIN_CLIENT_ID=tech-support-admin
KEYCLOAK_API_AUDIENCE=tech-support-admin
# KEYCLOAK_JWKS_URL=
# Admin SPA (apps/admin):
# VITE_KEYCLOAK_URL=http://localhost:8081
# VITE_KEYCLOAK_REALM=tech-support
# VITE_KEYCLOAK_CLIENT_ID=tech-support-admin

